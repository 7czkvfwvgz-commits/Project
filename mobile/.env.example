# Copy to mobile/.env (git-ignored). These values are PUBLIC: Expo inlines EXPO_PUBLIC_*
# variables into the app bundle, so never put an API key here. Provider keys belong
# only in server/.env on the proxy.

# URL of the proxy in server/ (optional). Without it the app uses openfootball only
# and shows football-data.org / The Odds API as "not configured".
# On a physical iPhone use your computer's LAN address, e.g. http://192.168.1.20:8787,
# or a deployed Cloudflare Worker URL.
EXPO_PUBLIC_PROXY_URL=

# Optional: must match CLIENT_TOKEN in server/.env if you set one there.
EXPO_PUBLIC_PROXY_CLIENT_TOKEN=
