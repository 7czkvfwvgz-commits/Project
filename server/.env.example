# Copy to .env (never commit .env). All keys are optional: endpoints whose key is
# missing answer 503 {"error":"missing_credentials"} and the app shows that state.

# Free key from https://www.football-data.org/client/register (free tier: 12 competitions, 10 req/min)
FOOTBALL_DATA_API_KEY=

# Free key from https://the-odds-api.com (free plan: small monthly credit quota)
ODDS_API_KEY=

# Optional: if set, the app must send the same value as X-Client-Token
# (set EXPO_PUBLIC_PROXY_CLIENT_TOKEN in mobile/.env). Deters casual quota use; not a secret.
CLIENT_TOKEN=

# Port for the local Node server
PORT=8787
